{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "standard",
            "level": "INFO"
        },
        "file": {
            "class": "logging.handlers.TimedRotatingFileHandler",
            "filename": "/app/logs/news-consumer-ingester.log",
            "when": "midnight",
            "interval": 1,
            "backupCount": 14,
            "utc": true,
            "encoding": "utf-8",
            "formatter": "standard",
            "level": "INFO"
        }
    },
    "root": {
        "handlers": [
            "console",
            "file"
        ],
        "level": "DEBUG"
    },
    "loggers": {
        "httpx": {
            "level": "WARNING"
        },
        "httpcore": {
            "level": "WARNING"
        }
    }
}
